# ============================================
# XCSM BACKEND - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ============================================
# Copy this file to .env and fill in the actual values.
# The values below are defaults for a local development environment.
# ============================================

# =======================
# DJANGO CONFIGURATION
# =======================
SECRET_KEY=xcsm-dev-secret-key-2025-12-20-change-this-in-production-9876543210
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TIME_ZONE=Africa/Douala
LANGUAGE_CODE=fr-fr

# =======================
# DATABASE CONFIGURATION (MySQL)
# =======================
DB_ENGINE=mysql
DB_NAME=xcsm_db
DB_USER=xcsm_admin
DB_PASSWORD=xcsm-your-db-password-here
DB_HOST=localhost
DB_PORT=3306
DB_MAX_CONNECTIONS=20
DB_CONN_MAX_AGE=300

# =======================
# MONGODB CONFIGURATION
# =======================
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=xcsm_granules_db
MONGO_USERNAME=xcsm_mongo_admin
MONGO_PASSWORD=xcsm-your-mongo-password-here
MONGO_AUTH_SOURCE=admin
MONGO_AUTH_MECHANISM=SCRAM-SHA-256
USE_MONGODB=True
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# =======================
# REDIS CONFIGURATION
# =======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=xcsm-your-redis-password-here
REDIS_DATABASE=0
USE_REDIS=True
REDIS_MAX_CONNECTIONS=10
REDIS_CACHE_TTL_GENERAL=300

# =======================
# CELERY CONFIGURATION
# =======================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ACCEPT_CONTENT=['json']
CELERY_TASK_SERIALIZER='json'
CELERY_RESULT_SERIALIZER='json'
CELERY_TIMEZONE=Africa/Douala

# =======================
# FILE UPLOAD CONFIGURATION
# =======================
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,docx,txt,html
MEDIA_ROOT=media/
MEDIA_URL=/media/
STATIC_ROOT=staticfiles/
STATIC_URL=/static/
UPLOAD_DIRECTORY=media/documents_bruts/
PROCESSED_DIRECTORY=resultats/
LOG_DIRECTORY=logs/

# =======================
# JWT AUTHENTICATION CONFIGURATION
# =======================
JWT_SECRET=xcsm-jwt-dev-secret-2025-4gi-enspy-promo-2027
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=900
JWT_REFRESH_TOKEN_LIFETIME=604800
JWT_ISSUER=xcsm-backend-dev
JWT_AUDIENCE=xcsm-clients-dev

# =======================
# SMTP / EMAIL CONFIGURATION
# =======================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=XCSM Platform <your-email@gmail.com>
EMAIL_SUBJECT_PREFIX=[XCSM DEV]

# =======================
# FRONTEND INTEGRATION (CORS)
# =======================
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=True
CORS_MAX_AGE=3600
FRONTEND_URL=http://localhost:3000

# =======================
# SECURITY CONFIGURATION
# =======================
SESSION_COOKIE_AGE=1209600
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
X_FRAME_OPTIONS=DENY
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True

# =======================
# LOGGING CONFIGURATION
# =======================
LOG_LEVEL_DJANGO=INFO
LOG_LEVEL_XCSM=DEBUG
LOG_LEVEL_DB=WARNING
LOG_FILE_PATH=logs/xcsm_backend.log
ERROR_LOG_FILE_PATH=logs/xcsm_errors.log
ACCESS_LOG_FILE_PATH=logs/xcsm_access.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# =======================
# DOCUMENT PROCESSING CONFIGURATION
# =======================
PDF_EXTRACTION_ENGINE=pymupdf
PDF_MAX_PAGES=1000
PDF_EXTRACT_IMAGES=False
PDF_PRESERVE_LAYOUT=True
DOCX_CONVERTER=mammoth
DOCX_PRESERVE_STYLES=True
DOCX_CONVERT_IMAGES=False
GRANULE_MIN_LENGTH=50
GRANULE_MAX_LENGTH=2000
GRANULE_SEPARATOR_PATTERNS=\n\n,\r\n\r\n,<br/>,<p>
TITLE_DETECTION_THRESHOLD=0.7

# =======================
# API CONFIGURATION
# =======================
API_VERSION=v1
API_BASE_PATH=api/
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST=10
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# =======================
# NOTIFICATIONS CONFIGURATION
# =======================
NOTIFY_ON_DOCUMENT_PROCESSED=True
NOTIFY_ON_ERROR=True
NOTIFY_ON_SYSTEM_ALERT=True
FIREBASE_CREDENTIALS_PATH=config/firebase-credentials.json

# =======================
# MONITORING AND METRICS
# =======================
ENABLE_METRICS=True
ENABLE_HEALTH_CHECKS=True
PROMETHEUS_METRICS_PATH=/metrics

# =======================
# BACKUP CONFIGURATION
# =======================
ENABLE_AUTO_BACKUP=False
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_DIRECTORY=backups/
BACKUP_MYSQL=True
BACKUP_MONGODB=True

# =======================
# DEVELOPMENT SETTINGS
# =======================
ENABLE_DEBUG_TOOLBAR=True
ENABLE_SQL_LOGGING=True
ENABLE_PROFILING=False
CREATE_TEST_DATA=True
TEST_DOCUMENTS_COUNT=3
TEST_USERS_COUNT=5

# =======================
# SCRIPT CONFIGURATION
# =======================
AUTO_CREATE_SUPERUSER=True
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@xcsm.local
SUPERUSER_PASSWORD=admin123xcsm
AUTO_CREATE_TEST_DATA=True
